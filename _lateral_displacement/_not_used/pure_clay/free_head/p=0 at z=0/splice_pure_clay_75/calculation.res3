    1---- Header: calculation.pgjson                                                      
    2---- *                                                                               
    3---- SPLICE Version: 2009-09-01                                                      
    4---- *                                                                               
    5---- * Date         Sign    Log of Corrections                                       
    6---- * 14 Jul 2009  cjfc    New input file for SPLICE revision 5                     
    7---- *                                                                               
    8----                                                                                 
    9----  ****************** CONTROL SECTION                                             
   10----   1.0    CONFRC    Old-force-unit  = CONFRC * New-force-unit  1MN  = 1000*1KN   
   11----   1.0    CONLTH    Old-length-unit = CONLTH * New-length-unit  1M  = 3.28*1FT   
   12----   1      NPH       Number of pile heads including dummy piles (max is 300)      
   13----   1      NLPH      Number of pile heads with given loads (max is 5)             
   14----   0      JACK      Superstructure code (0=None 1=Present 2=Generate)            
   15----   1      NUMVEC    Number of load vectors to be analysed (limit is 75 by Splice,
   16----   00     ISTART    Code 'IJ' for save/read of re-start values (I=Save J=Read)   
   17----   1      ISECM     Code for second order moments (0=Neglect 1=Include)          
   18----   0      NURCHK    Cross section strength UR check (0=No 1=NORSOK 2=ISO-19902)  
   19----   1111   IPRT1     Print code 'IJKL' (L=Piles K=Loads J=Soil I=Soil.disp)       
   20----   1      JECHO     Echo print of input file NF5 to file NF14 (0=No 1=Yes)       
   21----   0 0 0 100 0        Misc(1) - Misc(5)  Special purpose parameters              
   22----                                                                                 
   23----  ****************** PILE/SOIL/PILE INTERACTION, SOIL PROFILES AND SCOUR SECTION 
   24----   0     INTER     Mindlin interaction code (0=No 1=Dif.piles 2=Full -1=Avail)   
   25----   0.0   DISTIN    Maximum interaction distance                                  
   26----  Pile1 Pile2 Soil.profile  Z.scour P-Y.pfact  T-Z.tfact  Q-Z.qfact              
   27----   1 1 Soil1 0.000 1.0 1.0 1.0                                                   
   28----                                                                                 
   29----  ****************** POINT FORCES SECTION                                        
   30----     0     IFRC      Number of given point forces                                
   31----   Force    X-coord  Y-coord  Z-coord     X-FORCE  Y-FORCE  Z-FORCE              
   32----                                                                                 
   33----  ****************** LOAD APPLICATION SECTION                                    
   34----   0.000 0.000 1.000   ACCX,ACCY,ACCZ   Gravity loading ratio in X- Y- AND Z-dir 
   35----  VECTOR  NUMINC  KEEP  VECMLT  SOLMLT  FRCMLT                                   
   36----   1 20 0 1.000 1.000 1.000                                                      
   37----  VECTOR  INCR  MAXIT  IPRT2  IPRT3  NPTRC   QTOT  CONV    Misc(6,7,8,9,10,11)   
   38----   1 1 500 1111 1111 1 .050 0.000010 1 0 0 8 0 0                                 
   39----   1 2 500 1111 1111 1 .100 0.000010 1 0 0 8 0 0                                 
   40----   1 3 500 1111 1111 1 .150 0.000010 1 0 0 8 0 0                                 
   41----   1 4 500 1111 1111 1 .200 0.000010 1 0 0 8 0 0                                 
   42----   1 5 500 1111 1111 1 .250 0.000010 1 0 0 8 0 0                                 
   43----   1 6 500 1111 1111 1 .300 0.000010 1 0 0 8 0 0                                 
   44----   1 7 500 1111 1111 1 .350 0.000010 1 0 0 8 0 0                                 
   45----   1 8 500 1111 1111 1 .400 0.000010 1 0 0 8 0 0                                 
   46----   1 9 500 1111 1111 1 .450 0.000010 1 0 0 8 0 0                                 
   47----   1 10 500 1111 1111 1 .500 0.000010 1 0 0 8 0 0                                
   48----   1 11 500 1111 1111 1 .600 0.000010 1 0 0 8 0 0                                
   49----   1 12 500 1111 1111 1 .700 0.000010 1 0 0 8 0 0                                
   50----   1 13 500 1111 1111 1 .800 0.000010 1 0 0 8 0 0                                
   51----   1 14 500 1111 1111 1 .900 0.000010 1 0 0 8 0 0                                
   52----   1 15 500 1111 1111 1 1.000 0.000010 1 0 0 8 0 0                               
   53----   1 16 500 1111 1111 1 1.500 0.000010 1 0 0 8 0 0                               
   54----   1 17 500 1111 1111 1 2.000 0.000010 1 0 0 8 0 0                               
   55----   1 18 500 1111 1111 1 2.500 0.000010 1 0 0 8 0 0                               
   56----   1 19 500 1111 1111 1 3.000 0.000010 1 0 0 8 0 0                               
   57----   1 20 500 1111 1111 1 4.000 0.000010 1 0 0 8 0 0                               
   58---- C                                                                               
   59---- C VECTOR : LOAD VECTOR NUMBER  1,2,3,...,NUMVEC                                 
   60---- C NUMINC : NUMBER OF LOAD INCREMENTS FOR EACH VECTOR                            
   61---- C KEEP   : START CONDITION (0=ZERO 1=RESULTING CONDITION AFTER LAST VECTOR)     
   62---- C VECMLT : LOAD VECTOR MULTIPLIER FOR LOAD VALUES READ FROM FILE 'NF9'          
   63---- C SOLMLT : SOIL DISPL MULTIPLIER FOR VALUES READ FROM FILE 'NF10'               
   64---- C FRCMLT : POINT FORCE MULTIPLIER FOR POINT FORCES GIVEN ABOVE                  
   65---- C                                                                               
   66---- C VECTOR : LOAD VECTOR NUMBER  1,2,3,...,NUMVEC                                 
   67---- C INCR   : LOAD INCREMENT NUMBER FOR PRESENT VECTOR  1,2,3,...,NUMINC           
   68---- C MAXIT  : MAXIMUM NUMBER OF ITERATIONS                                         
   69---- C IPRT2  : PRINT CODE 'IJKL' (L=RES.DSP K=RES.FRC J=INC.DSP I=INC.FRC)          
   70---- C IPRT3  : PRINT CODE 'IJKL' (L=MATRIX  K=PIL.RES J=SUMMARY I=NF15.SAVING)      
   71---- C          K=2 GIVES LIMITED PILE OUTPUT WITH DEPTH                             
   72---- C          I=1 SAVES INTERFACE DISPL AND FORCES                                 
   73---- C          I=2 SAVES ALL DATA IN COMMON BLOCK /PILPRP/ , I=3 DOES BOTH          
   74---- C NPTRC  : TRACE PRINT OF PILE 'NPTRC' DURING ITERATIONS                        
   75---- C QTOT   : TOTAL LOAD (DISP) AFTER PRESENT INCR  (INCR=VECT*(QTOTNOW-QTOTLAST)) 
   76---- C CONV   : CONVERGENCE CRITERION (LENGTH)                                       
   77---- C                                                                               
   78---- C MISC(1) - MISC(11) ARE SPECIAL PURPOSE PARAMETERS                             
   79---- C                                                                               
   80---- C MISC(1) :  1=CHECK EQUATION SOLVER   2=PRINT VECTOR AND SUB-MATRICES          
   81---- C MISC(2) :  1=SKIP STIFFNESS MATRIX SYMMETRY ENFORCEMENT AT PILE HEADS         
   82---- C MISC(3) :  CONVERGENCE FACTOR DISPL  ( NEXT=(OLD*F+NEW)/(1+F)  F=MISC3/100 )  
   83---- C MISC(4) :  CONVERGENCE FACTOR FORCS  ( NEXT=(OLD*F+NEW)/(1+F)  F=MISC4/100 )  
   84---- C MISC(5) :  CONVERGENCE FACTOR STFNS  ( NEXT=(OLD*F+NEW)/(1+F)  F=MISC5/100 )  
   85---- C MISC(6) = 0  COMPUTE NEW SOIL DISPL DUE TO GROUP EFFECTS AFTER EACH ITERTN    
   86---- C         = 1  COMPUTE SOIL DISPL ONCE ONLY  (SHOULD SECURE CONVERGENCE)        
   87---- C MISC(7) = 1  PRINT INCR DSP AND FRC TO SCREEN AFTER EACH ITERATION            
   88---- C MISC(8) = 1  PRINT STIFFNESS VALUES TO SCREEN AFTER EACH ITERATION            
   89---- C MISC(9) = 9  PRINT PROGRAM CONTROL FLOW TO SCREEN                             
   90---- C MISC(9) = 8  SKIP AUTOMATIC DIVERGENCE CHECK                                  
   91---- C MISC(10)= NPND  TRACE PRINT OF VALUES FOR NODE 'ND' ON PILE 'NP' TO SCREEN    
   92---- C MISC(11)= NF DETAILED ELEMENT DATA TRACE SAVED ON UNIT 'NF'                   
   93----                                                                                 

