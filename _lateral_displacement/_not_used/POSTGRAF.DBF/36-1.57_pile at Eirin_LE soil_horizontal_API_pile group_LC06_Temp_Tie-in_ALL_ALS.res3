    2---- *                                                                               
    3---- SPLICE Version: 2009-09-01                                                      
    4---- *                                                                               
    5---- * Date         Sign    Log of Corrections                                       
    6---- * 14 Jul 2009  cjfc    New input file for SPLICE revision 5                     
    7---- *                                                                               
    8----                                                                                 
    9----  ****************** CONTROL SECTION                                             
   10----   1.0    CONFRC    Old-force-unit  = CONFRC * New-force-unit  1MN  = 1000*1KN   
   11----   1.0    CONLTH    Old-length-unit = CONLTH * New-length-unit  1M  = 3.28*1FT   
   12----   5      NPH       Number of pile heads including dummy piles (max is 300)      
   13----   1      NLPH      Number of pile heads with given loads (max is 5)             
   14----   0      JACK      Superstructure code (0=None 1=Present 2=Generate)            
   15----   1      NUMVEC    Number of load vectors to be analysed (limit is 75 by Splice,
   16----   00     ISTART    Code 'IJ' for save/read of re-start values (I=Save J=Read)   
   17----   1      ISECM     Code for second order moments (0=Neglect 1=Include)          
   18----   0      NURCHK    Cross section strength UR check (0=No 1=NORSOK 2=ISO-19902)  
   19----   1111   IPRT1     Print code 'IJKL' (L=Piles K=Loads J=Soil I=Soil.disp)       
   20----   1      JECHO     Echo print of input file NF5 to file NF14 (0=No 1=Yes)       
   21----   0 0 0 100 0        Misc(1) - Misc(5)  Special purpose parameters              
   22----                                                                                 
   23----  ****************** PILE/SOIL/PILE INTERACTION, SOIL PROFILES AND SCOUR SECTION 
   24----   0     INTER     Mindlin interaction code (0=No 1=Dif.piles 2=Full -1=Avail)   
   25----   0.0   DISTIN    Maximum interaction distance                                  
   26----  Pile1 Pile2 Soil.profile  Z.scour P-Y.pfact  T-Z.tfact  Q-Z.qfact              
   27----   1 1 Soil1 2.000 1.0 1.0 1.0                                                   
   28----   2 2 Soil1 2.000 1.0 1.0 1.0                                                   
   29----   3 3 Soil1 2.000 1.0 1.0 1.0                                                   
   30----   4 4 Soil1 2.000 1.0 1.0 1.0                                                   
   31----   5 5 Soil1 9999.000 1.0 1.0 1.0                                                
   32----                                                                                 
   33----  ****************** POINT FORCES SECTION                                        
   34----     0     IFRC      Number of given point forces                                
   35----   Force    X-coord  Y-coord  Z-coord     X-FORCE  Y-FORCE  Z-FORCE              
   36----                                                                                 
   37----  ****************** LOAD APPLICATION SECTION                                    
   38----   0.000 0.000 1.000   ACCX,ACCY,ACCZ   Gravity loading ratio in X- Y- AND Z-dir 
   39----  VECTOR  NUMINC  KEEP  VECMLT  SOLMLT  FRCMLT                                   
   40----   1 5 0 1.000 1.000 1.000                                                       
   41----  VECTOR  INCR  MAXIT  IPRT2  IPRT3  NPTRC   QTOT  CONV    Misc(6,7,8,9,10,11)   
   42----   1 1 500 1111 1111 1 .200 0.000010 1 0 0 8 0 0                                 
   43----   1 2 500 1111 1111 1 .400 0.000010 1 0 0 8 0 0                                 
   44----   1 3 500 1111 1111 1 .600 0.000010 1 0 0 8 0 0                                 
   45----   1 4 500 1111 1111 1 .800 0.000010 1 0 0 8 0 0                                 
   46----   1 5 500 1111 1111 1 1.000 0.000010 1 0 0 8 0 0                                
   47---- C                                                                               
   48---- C VECTOR : LOAD VECTOR NUMBER  1,2,3,...,NUMVEC                                 
   49---- C NUMINC : NUMBER OF LOAD INCREMENTS FOR EACH VECTOR                            
   50---- C KEEP   : START CONDITION (0=ZERO 1=RESULTING CONDITION AFTER LAST VECTOR)     
   51---- C VECMLT : LOAD VECTOR MULTIPLIER FOR LOAD VALUES READ FROM FILE 'NF9'          
   52---- C SOLMLT : SOIL DISPL MULTIPLIER FOR VALUES READ FROM FILE 'NF10'               
   53---- C FRCMLT : POINT FORCE MULTIPLIER FOR POINT FORCES GIVEN ABOVE                  
   54---- C                                                                               
   55---- C VECTOR : LOAD VECTOR NUMBER  1,2,3,...,NUMVEC                                 
   56---- C INCR   : LOAD INCREMENT NUMBER FOR PRESENT VECTOR  1,2,3,...,NUMINC           
   57---- C MAXIT  : MAXIMUM NUMBER OF ITERATIONS                                         
   58---- C IPRT2  : PRINT CODE 'IJKL' (L=RES.DSP K=RES.FRC J=INC.DSP I=INC.FRC)          
   59---- C IPRT3  : PRINT CODE 'IJKL' (L=MATRIX  K=PIL.RES J=SUMMARY I=NF15.SAVING)      
   60---- C          K=2 GIVES LIMITED PILE OUTPUT WITH DEPTH                             
   61---- C          I=1 SAVES INTERFACE DISPL AND FORCES                                 
   62---- C          I=2 SAVES ALL DATA IN COMMON BLOCK /PILPRP/ , I=3 DOES BOTH          
   63---- C NPTRC  : TRACE PRINT OF PILE 'NPTRC' DURING ITERATIONS                        
   64---- C QTOT   : TOTAL LOAD (DISP) AFTER PRESENT INCR  (INCR=VECT*(QTOTNOW-QTOTLAST)) 
   65---- C CONV   : CONVERGENCE CRITERION (LENGTH)                                       
   66---- C                                                                               
   67---- C MISC(1) - MISC(11) ARE SPECIAL PURPOSE PARAMETERS                             
   68---- C                                                                               
   69---- C MISC(1) :  1=CHECK EQUATION SOLVER   2=PRINT VECTOR AND SUB-MATRICES          
   70---- C MISC(2) :  1=SKIP STIFFNESS MATRIX SYMMETRY ENFORCEMENT AT PILE HEADS         
   71---- C MISC(3) :  CONVERGENCE FACTOR DISPL  ( NEXT=(OLD*F+NEW)/(1+F)  F=MISC3/100 )  
   72---- C MISC(4) :  CONVERGENCE FACTOR FORCS  ( NEXT=(OLD*F+NEW)/(1+F)  F=MISC4/100 )  
   73---- C MISC(5) :  CONVERGENCE FACTOR STFNS  ( NEXT=(OLD*F+NEW)/(1+F)  F=MISC5/100 )  
   74---- C MISC(6) = 0  COMPUTE NEW SOIL DISPL DUE TO GROUP EFFECTS AFTER EACH ITERTN    
   75---- C         = 1  COMPUTE SOIL DISPL ONCE ONLY  (SHOULD SECURE CONVERGENCE)        
   76---- C MISC(7) = 1  PRINT INCR DSP AND FRC TO SCREEN AFTER EACH ITERATION            
   77---- C MISC(8) = 1  PRINT STIFFNESS VALUES TO SCREEN AFTER EACH ITERATION            
   78---- C MISC(9) = 9  PRINT PROGRAM CONTROL FLOW TO SCREEN                             
   79---- C MISC(9) = 8  SKIP AUTOMATIC DIVERGENCE CHECK                                  
   80---- C MISC(10)= NPND  TRACE PRINT OF VALUES FOR NODE 'ND' ON PILE 'NP' TO SCREEN    
   81---- C MISC(11)= NF DETAILED ELEMENT DATA TRACE SAVED ON UNIT 'NF'                   
   82----                                                                                 

