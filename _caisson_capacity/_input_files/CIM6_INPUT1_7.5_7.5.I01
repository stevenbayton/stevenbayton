CIM6_INPUT1_7.5_7.5.PDF                                               ! card 1.3 PFILE  = output plot filename [PDF format] [255 char]
CAISSON_VHM                                               ! card 1.4 CPROG  = program name = 'CAISSON_VHM'      [020 char]
INPUT1			                      ! card 1.5 RTITLE = a/n run title                     [132 char]
EMPTY                                              ! card 1.6 PTITLE = a/n project(plate) title          [132 char]
EMPTY                                              ! card 1.7 PROJNO = a/n report/project number         [030 char]
CIM6                                              ! card 1.8 LOCATN = a/n location name                 [030 char]

